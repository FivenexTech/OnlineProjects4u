NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
PASSWORD_RESET_URL=http://localhost:5173/reset-password
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.invalid
EMAIL_PROVIDER_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PRIVATE_STORAGE_BUCKET=
